# Rust
target/

# Node (extensions, later)
node_modules/
npm-debug.log*

# macOS
.DS_Store

# Xcode (later)
xcuserdata/
*.xcuserstate
DerivedData/
build/

# Downloaded filter lists, not committed
filterlists/*.txt
filterlists/*.json
!filterlists/.gitkeep

# Synced copies inside the Safari extension bundle
safari-ext/filters/*.txt
safari-ext/filters/*.json
!safari-ext/filters/.gitkeep

# Synced copies inside the Chrome extension bundle
chrome-ext/filters/*.txt
chrome-ext/filters/*.json
!chrome-ext/filters/.gitkeep

# Chrome's auto-generated indexed ruleset
chrome-ext/_metadata/

# WASM build output, regenerated by scripts/build-wasm-engine.sh
safari-ext/engine/

# Compiled declarativeNetRequest ruleset, regenerated by scripts/build-rules.sh
safari-ext/rules.json
chrome-ext/rules.json

# Playwright test artefacts
test-output/

# Generated FFI header (regenerated each build by cbindgen)
engine-rs/include/

# Swift package build output and vendored bridge artefacts
engine-swift/.build/
engine-swift/Sources/CManeEngine/mane_engine.h

# Editor
.vscode/
.idea/
*.swp
