# Rust
target/

# Node (extensions, later)
node_modules/
npm-debug.log*

# macOS
.DS_Store

# Xcode (later)
xcuserdata/
*.xcuserstate
DerivedData/
build/

# Downloaded filter lists, not committed
filterlists/*.txt
filterlists/*.json
!filterlists/.gitkeep

# Synced copies inside the Safari extension bundle
safari-ext/filters/*.txt
safari-ext/filters/*.json
!safari-ext/filters/.gitkeep

# WASM build output, regenerated by scripts/build-wasm-engine.sh
safari-ext/engine/

# Generated FFI header (regenerated each build by cbindgen)
engine-rs/include/

# Swift package build output and vendored bridge artefacts
engine-swift/.build/
engine-swift/Sources/CManeEngine/mane_engine.h

# Editor
.vscode/
.idea/
*.swp
